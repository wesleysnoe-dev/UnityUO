  "masking_defects_and_jpeg_halo": {
    "expected": "JPEG sources have near-black compression fringe around gold/silver filigree. Soft-alpha fringe cleanup reduces hard matte lines but some dark halo may remain at sharp points.",
    "interior_black": "Preserved opaque (verified input slots mean alpha 255).",
    "do_not": "Do not global-key black; that would punch holes in panels/logo engraving.",
    "logo_wisps": "Any intentional dark edge distress on the logo crest is preserved with the art; only exterior-connected black was cleared."
  },
  "related_video_assets_note": "Login video/music assets live separately under /workspace/login-background-assets/ (muted loop + LoginLoop.mp3). This pack is UI chrome only.",
