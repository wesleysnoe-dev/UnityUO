{
  "title": "Unity UO login UI art pack",
  "purpose": "Asset handoff only. Transparent PNGs extracted from Wes-supplied JPEGs for login screen over video background. No Unity/code changes in this pack.",
  "method": {
    "masking": "Contiguous exterior near-black flood-fill from image edges only (seed max-channel<=12, fringe expand <=26-28). Soft alpha on JPEG near-black fringe adjacent to exterior. NOT a global black chroma key \u2014 interior charcoal panels, engraved dark metal, and input-slot blacks remain opaque.",
    "labels": "Account Name / Password / Login glyphs are baked into the art as decorative labels and must stay. Unity must draw the typed account/password text into the input slots separately.",
    "no_generated_art": true
  },
