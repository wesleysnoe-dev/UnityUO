<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Unity-side files with no UnityEngine dependency, compiled here so their rules can be tested. -->
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\AccountStore.PathRule.cs" Link="Unity\AccountStore.PathRule.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\LaunchOptions.cs" Link="Unity\LaunchOptions.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\HoverTooltip.Placement.cs" Link="Unity\HoverTooltip.Placement.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\ContextMenuWindow.Placement.cs" Link="Unity\ContextMenuWindow.Placement.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UOClient.IO\UOClient.IO.csproj" />
    <ProjectReference Include="..\UOClient.ArtPipeline\UOClient.ArtPipeline.csproj" />
    <ProjectReference Include="..\UOClient.Core\UOClient.Core.csproj" />
  </ItemGroup>
</Project>
