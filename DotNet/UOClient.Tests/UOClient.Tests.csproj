<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Saved shard gump layouts (GumpFixtureTests). -->
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Unity-side files with no UnityEngine dependency, compiled here so their rules can be tested. -->
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\AccountStore.PathRule.cs" Link="Unity\AccountStore.PathRule.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\LaunchOptions.cs" Link="Unity\LaunchOptions.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\HoverTooltip.Placement.cs" Link="Unity\HoverTooltip.Placement.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\ContextMenuWindow.Placement.cs" Link="Unity\ContextMenuWindow.Placement.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\SecureTradeWindow.Layout.cs" Link="Unity\SecureTradeWindow.Layout.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\BookWindow.Layout.cs" Link="Unity\BookWindow.Layout.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\BulletinBoardWindow.Layout.cs" Link="Unity\BulletinBoardWindow.Layout.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\ServerGumpWindow.Layout.cs" Link="Unity\ServerGumpWindow.Layout.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\GumpHtml.cs" Link="Unity\GumpHtml.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\UiRouting.cs" Link="Unity\UiRouting.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\HealthBarWindow.Layout.cs" Link="Unity\HealthBarWindow.Layout.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\StatusWindow.Layout.cs" Link="Unity\StatusWindow.Layout.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\QuestionWindow.Layout.cs" Link="Unity\QuestionWindow.Layout.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\UI\TargetCursor.Direction.cs" Link="Unity\TargetCursor.Direction.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\MobileActions.cs" Link="Unity\MobileActions.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\MobileLook.cs" Link="Unity\MobileLook.cs" />
    <Compile Include="$(AssetsDir)UOClient.Unity\Runtime\CorpseDraw.cs" Link="Unity\CorpseDraw.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UOClient.IO\UOClient.IO.csproj" />
    <ProjectReference Include="..\UOClient.ArtPipeline\UOClient.ArtPipeline.csproj" />
    <ProjectReference Include="..\UOClient.Core\UOClient.Core.csproj" />
  </ItemGroup>
</Project>
